# ── FrameForge environment ────────────────────────────────────────────────
# Copy to .env (gitignored — secrets never leave this machine).

# ── Provider selection (FREE-FIRST) ───────────────────────────────────────
# VIDEO_PROVIDER=mock    → simulated demo renderer. Default. Always $0.
# VIDEO_PROVIDER=free    → real AI video via a FREE backend (see FREE_BACKEND).
#                          Never calls paid APIs. If no free backend can serve,
#                          generations fail with a clear message — never faked.
# VIDEO_PROVIDER=runway  → paid Runway API (optional future provider).
#                          Requires RUNWAY_API_KEY. Nothing is spent unless you
#                          explicitly choose this mode AND top up Runway credits.
# If VIDEO_PROVIDER is unset, the legacy MOCK_VIDEO_MODE behavior applies.
VIDEO_PROVIDER=mock

# ── Cost-safety kill switch ───────────────────────────────────────────────
# Default false: paid providers (Runway, Claude API) can NEVER be called,
# even if their keys are present. Set to true only to deliberately spend.
ALLOW_PAID_PROVIDERS=false

# Legacy switch (kept for compatibility; VIDEO_PROVIDER takes precedence):
# MOCK_VIDEO_MODE=true   → mock provider only (default)
# MOCK_VIDEO_MODE=false  → runway provider (needs RUNWAY_API_KEY)
MOCK_VIDEO_MODE=true

# ── Free backend (only used when VIDEO_PROVIDER=free) ─────────────────────
# FREE_BACKEND=auto    → try local GPU first, then Gradio Space (default)
# FREE_BACKEND=local   → self-hosted model on this machine's GPU
# FREE_BACKEND=gradio  → Hugging Face Gradio Space (needs FREE_GRADIO_URL)
FREE_BACKEND=auto

# Your Gradio Space URL, e.g. https://yourname-wan21-t2v.hf.space
# Free Hugging Face accounts can host up to 2 ZeroGPU Spaces.
# See docs/FREE_SETUP.md for deployment steps and honest limits.
FREE_GRADIO_URL=
# Gradio endpoint name (default "predict"). The Space must accept
# predict(prompt: str, duration: int, ratio: str) and return a video file.
FREE_GRADIO_ENDPOINT=predict

# ── Prompt engine ─────────────────────────────────────────────────────────
# PROMPT_ENGINE=local  → free on-device heuristics (default when no Claude key)
# PROMPT_ENGINE=claude → Anthropic API — requires ANTHROPIC_API_KEY, never
#                        called without it.
# unset → Claude only if MOCK_CLAUDE=false AND ANTHROPIC_API_KEY is set.
PROMPT_ENGINE=
MOCK_CLAUDE=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ── Paid provider (OPTIONAL — only for VIDEO_PROVIDER=runway) ──────────────
RUNWAY_API_KEY=
# Runway model id for text/image-to-video (verified: gen4.5).
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_BASE_URL=https://api.dev.runwayml.com
# KLING_API_KEY=
# LUMA_API_KEY=

# --- Database / storage ---------------------------------------------------
DATABASE_PATH=./data/frameforge.db
STORAGE_DIR=./data/media

# --- Credits ---------------------------------------------------------------
# Credits granted to a brand-new user (demo).
NEW_USER_CREDITS=600

# --- Billing (future — not required for MVP) ------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=

# --- Optional admin logging to Google Sheets (future, never required) ------
# GOOGLE_SHEETS_LOG_ID=
# GOOGLE_SHEETS_API_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3100
