# ── FrameForge environment ──────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# --- Modes ---------------------------------------------------------------
# true = simulate video generation locally (no paid video APIs called).
MOCK_VIDEO_MODE=true
# true = use the local prompt structurer instead of the Claude API (no spend).
# Set to false + provide ANTHROPIC_API_KEY to use real Claude prompt enhancement.
MOCK_CLAUDE=true

# --- Claude (prompt intelligence layer) ----------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Video providers (real ones, configured later) ------------------------
# Each provider reads its own key only when MOCK_VIDEO_MODE=false.
# Keys are server-side only: never commit them, never expose to the client.
RUNWAY_API_KEY=
# Runway model id for text/image-to-video (verified: gen4.5).
RUNWAY_VIDEO_MODEL=gen4.5
# KLING_API_KEY=
# LUMA_API_KEY=

# --- Database / storage ---------------------------------------------------
DATABASE_PATH=./data/frameforge.db
STORAGE_DIR=./data/media

# --- Credits ---------------------------------------------------------------
# Credits granted to a brand-new user (demo).
NEW_USER_CREDITS=600

# --- Billing (future — not required for MVP) ------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=

# --- Optional admin logging to Google Sheets (future, never required) ------
# GOOGLE_SHEETS_LOG_ID=
# GOOGLE_SHEETS_API_KEY=

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000
